{
  "openapi": "3.0.3",
  "info": {
    "title": "",
    "version": ""
  },
  "paths": {
    "/api/taskDefList": {
      "get": {
        "tags": [
          "Task"
        ],
        "summary": "获取任务列表",
        "description": "获取系统中所有任务定义的列表",
        "operationId": "getTaskDefList",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功获取任务列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskDefinition"
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误"
          }
        },
        "deprecated": false,
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "TaskDefinition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "rewards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reward"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Condition"
            }
          },
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "objectives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Objective"
            }
          }
        }
      },
      "Condition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "met": {
            "type": "boolean"
          }
        },
        "required": [
          "met"
        ]
      },
      "Objective": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "targetAmount": {
            "type": "integer",
            "format": "int32"
          },
          "id": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          }
        },
        "required": [
          "targetAmount",
          "completed"
        ]
      },
      "Reward": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  }
}